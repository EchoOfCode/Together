# Firebase Configuration Example
# Copy this file to .env and fill in your real project values from Firebase Console:
# Firebase Console -> Project Settings -> General -> Your apps -> Web SDK config

VITE_FIREBASE_API_KEY=AIzaSy...
VITE_FIREBASE_AUTH_DOMAIN=your-calendar-app.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-calendar-app
VITE_FIREBASE_STORAGE_BUCKET=your-calendar-app.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=1234567890
VITE_FIREBASE_APP_ID=1:1234567890:web:abcdef123456
